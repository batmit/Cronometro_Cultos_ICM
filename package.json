{
  "name": "cronometro-cultos-icm",
  "version": "1.0.0",
  "description": "Cronômetro de cultos com versículos e notícias disponíveis offline",
  "author": "Cronômetro Cultos ICM",
  "private": true,
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "pack": "electron-builder --win --dir --x64",
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": { "electron": "^43.0.0", "electron-builder": "^26.0.0" },
  "build": {
    "appId": "br.org.icm.cronometrocultos",
    "productName": "Cronômetro Cultos ICM",
    "asar": true,
    "files": ["index.html", "painel.js", "noticias-cache.js", "versiculos.js", "assets/**/*", "desktop/**/*", "package.json"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "installerLanguages": ["pt_BR"] }
  }
}
